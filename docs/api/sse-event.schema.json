{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zai-todo-task.local/schemas/sse-event.schema.json",
  "title": "ChatRunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "type", "runId", "data"],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": ["meta", "delta", "usage", "done", "error", "heartbeat"]
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "messageId": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/meta"
        },
        {
          "$ref": "#/$defs/delta"
        },
        {
          "$ref": "#/$defs/usage"
        },
        {
          "$ref": "#/$defs/done"
        },
        {
          "$ref": "#/$defs/error"
        },
        {
          "$ref": "#/$defs/heartbeat"
        }
      ]
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "modelAlias", "requestId"],
      "properties": {
        "messageId": {
          "type": "string"
        },
        "modelAlias": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "done": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedAt"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "cancelled", "failed"]
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverTime"],
      "properties": {
        "serverTime": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
