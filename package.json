{
  "name": "zai-chat-mp",
  "version": "1.0.0",
  "private": true,
  "description": "AI 聊天智能体微信小程序",
  "packageManager": "pnpm@10.10.0",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "typecheck": "tsc --noEmit",
    "lint": "node ./scripts/lint.mjs",
    "test:run": "vitest run",
    "openapi": "openapi-ts",
    "contract:check": "openapi-ts && node ./scripts/check-api-contract.mjs",
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "pnpm build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "pnpm build:h5 -- --watch",
    "check": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm build:weapp"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "riskmonster",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@taroify/core": "^1.0.6",
    "@taroify/icons": "^1.0.6",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tarojs/cli": "4.3.2",
    "@tarojs/plugin-generator": "4.3.2",
    "@tarojs/vite-runner": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/minimatch": "^5",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-preset-taro": "4.3.2",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.3.2",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^16.1.2",
    "openapi-ts-request": "1.10.0",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "terser": "^5.30.4",
    "typescript": "^5.4.5",
    "vite": "^4.2.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tarojs/binding",
      "@tarojs/cli",
      "core-js",
      "core-js-pure",
      "esbuild"
    ]
  }
}
