{
  "name": "zai-chat-mp",
  "version": "1.0.0",
  "private": true,
  "description": "小翟 AI 聊天智能体微信小程序",
  "packageManager": "pnpm@10.34.9",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "pnpm --dir tests typecheck",
    "lint": "node ./scripts/lint.mjs",
    "test:run": "pnpm --dir tests test:run",
    "openapi": "openapi-ts",
    "contract:check": "openapi-ts && node ./scripts/check-api-contract.mjs",
    "clean:weapp": "node ./scripts/clean.mjs dist/weapp",
    "clean:h5": "node ./scripts/clean.mjs dist/h5",
    "clean:cache": "node ./scripts/clean.mjs .cache .temp .swc",
    "clean:deps-cache": "node ./scripts/clean.mjs .pnpm-store node_modules/.cache node_modules/.vite",
    "clean:build": "node ./scripts/clean.mjs dist/weapp dist/h5",
    "build:weapp": "pnpm clean:weapp && taro build --type weapp",
    "dev:weapp": "pnpm build:weapp -- --watch",
    "build:h5": "pnpm clean:h5 && taro build --type h5",
    "dev:h5": "pnpm build:h5 -- --watch",
    "toolchain:check": "node ./scripts/check-toolchain.mjs",
    "check": "pnpm contract:check && pnpm typecheck && pnpm test:typecheck && pnpm lint && pnpm test:run && pnpm toolchain:check && pnpm build:weapp && pnpm build:h5"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "riskmonster",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@taroify/core": "1.0.6",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "7.29.7",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@tarojs/cli": "4.3.2",
    "@tarojs/plugin-generator": "4.3.2",
    "@tarojs/vite-runner": "4.3.2",
    "@types/minimatch": "5.1.2",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@vitejs/plugin-react": "4.7.0",
    "babel-preset-taro": "4.3.2",
    "eslint": "8.57.1",
    "eslint-config-taro": "4.3.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "openapi-ts-request": "1.10.0",
    "postcss": "8.5.32",
    "react-refresh": "0.14.2",
    "sass": "1.108.1",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "38.0.0",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "vite": "4.5.14"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=10.34.9 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tarojs/binding",
      "@tarojs/cli",
      "core-js",
      "core-js-pure",
      "esbuild"
    ]
  }
}
